# ============================================================
#  Automation Center — frontend (Vite / React)
#  Copy to `.env.local` for local dev. Vercel reads these from
#  Project Settings → Environment Variables (never commit real values).
# ============================================================

# Base URL of the FastAPI backend (no trailing slash).
#   local  : http://localhost:8080
#   prod   : https://api.automation-center.example
VITE_API_URL=http://localhost:8080

# WebSocket base URL of the backend (no trailing slash, no path).
# Optional: if unset it is derived from VITE_API_URL
# (http->ws, https->wss).
#   local  : ws://localhost:8080
#   prod   : wss://api.automation-center.example
VITE_WS_URL=ws://localhost:8080

# Shown in the UI footer / settings. Purely cosmetic.
VITE_APP_ENV=development
